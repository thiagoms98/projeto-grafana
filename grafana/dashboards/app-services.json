{
  "annotations": {"list": []},
  "description": "Disponibilidade, tráfego e latência da aplicação App Services.",
  "editable": true,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "up{job=\"app-services\"}", "legendFormat": "1 = online", "refId": "A"}],
      "title": "Disponibilidade (1 = online)", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}, "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(rate(webapp_http_requests_total[1m]))", "legendFormat": "requisições/s", "refId": "A"}],
      "title": "Taxa de requisições", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}, "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(webapp_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}],
      "title": "Latência p95", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}, "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(webapp_visits_total)", "legendFormat": "visitas", "refId": "A"}],
      "title": "Visitas registradas", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12}}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 5}, "id": 5,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "sum by (route) (rate(webapp_http_requests_total[1m]))", "legendFormat": "{{route}}", "refId": "A"}],
      "title": "Requisições por rota", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12}}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 5}, "id": 6,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (route, le) (rate(webapp_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A"}],
      "title": "Latência p95 por rota", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14}, "id": 7,
      "options": {"showHeader": true, "cellHeight": "sm"},
      "targets": [{"expr": "sum by (route, method, status) (increase(webapp_http_requests_total[5m]))", "format": "table", "instant": true, "refId": "A"}],
      "title": "Requisições por rota e status (últimos 5 min)", "type": "table"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["app-services", "prometheus"],
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "title": "App Services · Monitoramento",
  "uid": "app-services",
  "version": 1
}
